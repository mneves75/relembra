#!/bin/sh
# Fast gate before every push: secrets, lint, types, and the tests the change can affect (Bun's
# import graph against origin/main; a docs-only push runs none, a change to the toolchain's
# configuration runs them all). Postgres tests are skipped here; scripts/ci.sh runs everything
# before a merge. `bun install` enables it (the `prepare` script sets core.hooksPath).
set -eu
cd "$(git rev-parse --show-toplevel)"
# In a linked worktree Git exports GIT_DIR to its hooks; the tests that create their own temporary
# repositories would inherit it and run git against this one. The cwd is enough from here on.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# Git passes one line per pushed ref; a push that only deletes remote branches sends no code.
refs=0 code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  refs=$((refs + 1))
  case $local_sha in *[!0]*) code=1 ;; esac
done
if [ "$refs" -gt 0 ] && [ "$code" = 0 ]; then exit 0; fi

gitleaks git --no-banner --redact
bun run lint
bun run typecheck

# The import graph does not see the toolchain's configuration: when it changes, run every test.
changed="--changed=origin/main"
if git diff --name-only origin/main -- package.json bun.lock bunfig.toml 'tsconfig*.json' |
  grep -q .; then
  changed=""
fi
# An exported Postgres URL would bring the Postgres tests back, in parallel workers.
env -u RELEMBRA_POSTGRES_URL RELEMBRA_SKIP_POSTGRES=1 bun test --parallel $changed
